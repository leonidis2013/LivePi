#!/bin/bash
# Root helper for LiveHost OS updates. The installer lets the LiveHost user run exactly:
#   sudo /usr/local/sbin/livehost-os check
#   sudo /usr/local/sbin/livehost-os upgrade
# It starts the job as a separate systemd unit, so a LiveHost restart cannot interrupt apt/dpkg.
set -u
DIR="${LIVEHOST_OS_DIR:-/var/lib/livehost-os}"
JOB=/usr/local/sbin/livehost-os-job

verb="${1:-}"
case "$verb" in
  check|upgrade) ;;
  *) echo "usage: livehost-os check|upgrade" >&2; exit 2 ;;
esac

mkdir -p "$DIR"
chmod 755 "$DIR"

if [ "$(cat "$DIR/state" 2>/dev/null)" = running ] && systemctl is-active --quiet livehost-os-job.service 2>/dev/null; then
  echo "busy" >&2
  exit 3
fi

: > "$DIR/log"
rm -f "$DIR/exit" "$DIR/finished"
echo "$verb" > "$DIR/verb"
echo running > "$DIR/state"
chmod 644 "$DIR/log" "$DIR/verb" "$DIR/state"

exec systemd-run --quiet --collect --unit=livehost-os-job --no-block "$JOB" "$verb"
